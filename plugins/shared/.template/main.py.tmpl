    # from your_module import transform
    # data = transform(params)

    result = {"status": "success", "data": {}}

    # 写入结果供下游步骤使用
    result_file = os.environ.get("RESULT_FILE")
    if result_file:
        with open(result_file, "w", encoding="utf-8") as f:
            json.dump(result, f, ensure_ascii=False)

    return result


if __name__ == "__main__":
    params = {}
    for arg in sys.argv[1:]:
        if arg.startswith("--"):
            if "=" in arg:
                k, v = arg[2:].split("=", 1)
                params[k] = v
            else:
                params[arg[2:]] = True

    try:
        result = run(params)
        print(f"[{{PLUGIN_NAME}}] 完成: {json.dumps(result, ensure_ascii=False)}")
    except Exception as e:
        print(f"[{{PLUGIN_NAME}}] 失败: {e}", file=sys.stderr)
        sys.exit(1)
