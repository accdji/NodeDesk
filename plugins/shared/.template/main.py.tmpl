import sys, json, os


def run(params: dict) -> dict:
    """你的转换逻辑写在这里

    Args:
        params: 从上游步骤和参数传入的数据

    Returns:
        dict: 执行结果，包含 status 和 data 字段
    """
    print(f"[{{PLUGIN_NAME}}] 开始执行, 参数: {params}")

    # TODO: 在这里调用你已有的转换函数
