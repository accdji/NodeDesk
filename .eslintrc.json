{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-undef": "warn",
    "no-extra-semi": "error",
    "eqeqeq": ["warn", "smart"]
  },
  "globals": {
    "d3": "readonly",
    "Alpine": "readonly",
    "htmx": "readonly",
    "EventSource": "readonly",
    "showToast": "writable",
    "t": "readonly",
    "LANG": "readonly"
  }
}
